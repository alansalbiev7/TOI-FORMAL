# Synthetic example in Turtle syntax; not a departmental ontology or a legal classification.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <https://example.org/toi-lab/tax#> .
ex:ontology a owl:Ontology ; rdfs:comment "Синтетический пример; внешние импорты не используются"@ru .
ex:AccruedIncome a owl:Class ; rdfs:label "Начисленный доход"@ru .
ex:PaidIncome a owl:Class ; rdfs:label "Выплаченный доход"@ru .
