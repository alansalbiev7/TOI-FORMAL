# Synthetic example in Turtle syntax; not a departmental ontology or a legal classification.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <https://example.org/toi-lab/registration#> .
ex:ontology a owl:Ontology ; rdfs:comment "Синтетический пример; внешние импорты не используются"@ru .
ex:PersonRecord a owl:Class ; rdfs:label "Учебная запись участника"@ru .
ex:AddressRecord a owl:Class ; rdfs:label "Учебная запись адреса"@ru .
