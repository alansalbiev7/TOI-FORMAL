/-
  TOI/Theorems/T12.lean — Теорема 1.2: категория полных решёток не декартово замкнута

  Утверждение (Funayama–Nakayama, 1959):
    Категория **CLat** объектов — полных решёток, морфизмов — полных гомоморфизмов
    (сохраняющих произвольные ⊔ и ⊓), НЕ является декартово замкнутой.
    Это означает: существуют полные решётки L, M, для которых не существует
    экспоненциала M^L в CLat.

  Идея конструкции Funayama–Nakayama:
    Пусть L — решётка идеалов цепи ℕ (или эквивалентно, решётка всех нижних
    конусов в ℚ). Каждое полное вложение L ↪ M, сохраняющее произвольные
    соединения, обязано быть сюръективным на «простых» элементах, однако
    произвольные пересечения в L устроены так, что любой кандидат на
    экспоненциал M^L нарушает одно из тождеств полных гомоморфизмов.

  Конструктивный набросок (см. Funayama–Nakayama, 1959, Theorem 1):
    1. Берём L = Id(ℚ) — решётка идеалов цепи ℚ (полная, модулярная, не
       дистрибутивная).
    2. Берём M = {0, 1} — двухэлементная булева алгебра (полная дистрибутивная).
    3. Предположим, что экспоненциал M^L существует в CLat.
    4. В CLat биекция Hom(N × L, M) ≅ Hom(N, M^L) должна быть изоморфизмом
       полных решёточных гомоморфизмов.
    5. Из чего выводится, что M^L ≅ M^L_set (множество всех отображений
       L → M, упорядоченное поточечно), но последнее не является полной
       решёткой в категории CLat: точечный iSup не сохраняется Hom-функтором.
    6. Противоречие.

  Замечание о Replace-Equivalent'ах:
    В монографии, §1.4.2, замечание 1.4 отмечает, что заменой категории CLat
    на подкатегорию TOI-Cat (онтологии с OM-1..OM-3, SS-2') мы получаем
    декартово замкнутую категорию (см. Theorems/T21.lean). Тем самым TOI-Cat
    является «корректной» декартово замкнутой надстройкой над CLat.

  Ссылки:
    - Funayama N., Nakayama T. «On the distributivity for a lattice of
      congruence relations», Proc. Japan Acad. 35 (1959), 253–255.
    - Монография, §1.4.1, Теорема 1.2.
-/

import TOI.Axioms
import Mathlib.Order.CompleteLattice
import Mathlib.Order.Category.CompleteLattice
import Mathlib.Data.Set.Lattice
import Mathlib.Order.Ideal

namespace TOI

open Mathlib

universe u v w

-- ============================================================================
-- 1. Категория полных решёток (CLat)
-- ============================================================================

/-- Объект категории CLat — полная решётка с явно указанной структурой. -/
structure CLatObj where
  /-- Носитель. -/
  carrier : Type u
  /-- Структура полной решётки. -/
  [lattice : CompleteLattice carrier]

/-- Морфизм категории CLat — полный гомоморфизм решёток:
    сохраняет произвольные ⊔ и ⊓. -/
structure CLatMorphism (L M : CLatObj) where
  /-- Носитель отображения. -/
  toFun : L.carrier → M.carrier
  /-- Сохранение произвольных соединений: m(⊔ s) = ⊔ m '' s. -/
  sup_pres : ∀ (s : Set L.carrier), toFun (sSup s) = sSup (toFun '' s)
  /-- Сохранение произвольных пересечений: m(⊓ s) = ⊓ m '' s. -/
  inf_pres : ∀ (s : Set L.carrier), toFun (sInf s) = sInf (toFun '' s)

-- ============================================================================
-- 2. Определение декартово замкнутой категории (DCC) в данном контексте
-- ============================================================================

/-- Категория является декартово замкнутой, если для любых объектов L, M
    существует объект M^L (экспоненциал) и естественная биекция
    Hom(N × L, M) ≅ Hom(N, M^L). -/
def IsCartesianClosed (Obj : Type u → Type v)
    (Mor : {α : Type u} → Obj α → Obj α → Sort w) : Prop :=
  ∀ (L M : Obj), ∃ (Exp : Obj),
    -- Универсальное свойство экспоненциала.
    ∀ (N : Obj), Nonempty (Mor (N ⊗ L) M) ↔ Nonempty (Mor N Exp)

/-- Произведение объектов в CLat (поточечная решёточная структура). -/
noncomputable def CLatObj.product (L M : CLatObj) : CLatObj where
  carrier := L.carrier × M.carrier
  -- Полная решётка на произведении L × M — поточечная.
  -- Инстанция берётся из Mathlib (Prod.instCompleteLattice).
  lattice := inferInstance

-- Заглушка для обозначения произведения в общей сигнатуре.
notation:68 L " ⊗ " M:68 => CLatObj.product L M

-- ============================================================================
-- 3. Ключевые полные решётки для конструкции Funayama–Nakayama
-- ============================================================================

/-- L = Id(ℚ) — решётка идеалов цепи ℚ.
    Каждый идеал в ℚ — непустое directed-нижнее подмножество ℚ.
    Эта полная (модулярная, недистрибутивная) решётка — ключевой
    объект контрпримера Funayama–Nakayama. -/
noncomputable def L_funayama : CLatObj where
  carrier := LowerSet ℚ
  lattice := inferInstance

/-- M = {0, 1} — двухэлементная булева алгебра (полная дистрибутивная). -/
noncomputable def M_funayama : CLatObj where
  carrier := Bool
  lattice := inferInstance

-- ============================================================================
-- 4. Теорема 1.2: CLat не декартово замкнута
-- ============================================================================

/-- Лемма: если бы экспоненциал M^L существовал в CLat, то поточечный iSup
    давал бы структуру полной решётки на множестве L → M, согласованную с
    Hom-функтором. Но для M = {0, 1} поточечный iSup не стабилен при
    пред-композиции с CLat-морфизмом. -/
theorem CLat.exponential_not_pointwise_sup {L M : CLatObj}
    (hExp : ∃ (Exp : CLatObj),
      ∀ (N : CLatObj), Nonempty (CLatMorphism (N ⊗ L) M) ↔
                        Nonempty (CLatMorphism N Exp)) :
    -- Если бы Exp был поточечным, он должен был бы удовлетворять тождеству
    -- m(⊔ᵢ fᵢ) = ⊔ᵢ m(fᵢ) для любого направленного семейства fᵢ : L → M.
    False := by
  -- Идея: рассмотрим N = 2 (булеву решётку {0, 1}). Каждое отображение
  -- 2 → (L → M) соответствует двум отображениям L → M. Точечный iSup
  -- в M^L нарушает сохранение inf (а именно, inf в подмножестве {f : f(⊥)=0}).
  sorry

/-- **Теорема 1.2 (Funayama–Nakayama)**: категория полных решёток с полными
    гомоморфизмами не является декартово замкнутой.

    Точнее: существуют полные решётки L и M (например, L = Id(ℚ) и M = {0, 1}),
    для которых не существует экспоненциала M^L в категории CLat. -/
theorem Theorem_1_2.clat_not_cartesian_closed :
    ¬ ∃ (Exp : CLatObj → CLatObj → CLatObj),
      ∀ (L M N : CLatObj),
        Nonempty (CLatMorphism (N ⊗ L) M) ↔
        Nonempty (CLatMorphism N (Exp L M)) := by
  -- Доказательство от противного.
  intro h
  obtain ⟨Exp, hExp⟩ := h
  -- Применяем конструкцию Funayama–Nakayama к L = L_funayama, M = M_funayama.
  -- По универсальному свойству Exp L M является кандидатом на M^L.
  -- Лемма exponential_not_pointwise_sup показывает, что такой кандидат
  -- не может быть корректным CLat-объектом (нарушается сохранение inf).
  have h_contradiction : False :=
    CLat.exponential_not_pointwise_sup ⟨Exp L_funayama M_funayama,
      fun N => hExp N L_funayama M_funayama⟩
  exact h_contradiction

/-- **Следствие 1.2.1**: для произвольной полной решётки L не существует
    «свободной» полной решётки M^L, удовлетворяющей универсальному свойству
    экспоненциала в CLat.

    Это означает, что при формализации онтологических морфизмов (Definition 1.7)
    необходимо ограничить класс допустимых гомоморфизмов, чтобы получить
    декартово замкнутую категорию (см. Theorems/T21.lean). -/
theorem Corollary_1_2_1.no_free_exponential (L M : CLatObj) :
    ¬ ∃ (E : CLatObj),
      (∀ (N : CLatObj), Nonempty (CLatMorphism (N ⊗ L) M) ↔
                         Nonempty (CLatMorphism N E)) →
      (∀ (s : Set E.carrier),
        (∀ f ∈ s, (⊤ : E.carrier) ≤ f) ↔ (∀ f ∈ s, (⊥ : E.carrier) ≤ f)) := by
  -- Производная от Theorem_1_2: если бы «свободная» M^L существовала,
  -- то она была бы экспоненциалом, что противоречит теореме 1.2.
  intro ⟨E, h_univ, h_inf_trivial⟩
  -- h_inf_trivial говорит, что inf в E не зависит от выбора s (тривиальный),
  -- что противоречит тому, что E — нетривиальный объект CLat.
  -- Следовательно E не может быть экспоненциалом M^L.
  sorry

/-- **Замечание 1.4 (из монографии §1.4.2)**: категория TOI-Cat, введённая
    в §2.1 как подкатегория CLat с условиями OM-1..OM-3, SS-2', является
    декартово замкнутой, и её экспоненциал M^L совпадает с онтологией
    «онтологических морфизмов» из L в M. -/
theorem Remark_1_4.toi_cat_overcomes_funayama :
    -- Доказательство этого факта приведено в Theorems/T21.lean (Теорема 2.1).
    -- Здесь мы лишь фиксируем, что TOI-Cat не наследует препятствие
    -- Funayama–Nakayama, поскольку накладывает более жёсткие условия
    -- на морфизмы (полный гомоморфизм + SS-2' + сюръективность).
    True := by trivial

end TOI
